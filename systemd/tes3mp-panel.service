[Unit]
Description=TES3MP Easy panel
Documentation=https://github.com/Saagilat/tes3mp-easy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=simple
User=tes3mp-panel
Group=tes3mp-panel
SupplementaryGroups=tes3mp
EnvironmentFile=-/etc/tes3mp-easy/panel.env
WorkingDirectory=/opt/tes3mp-easy
ExecStart=/opt/tes3mp-easy/bin/tes3mp-easy-panel
Restart=on-failure
RestartSec=60s
TimeoutStartSec=5min
Environment=GOMAXPROCS=1
# Argon2id needs a 32 MiB buffer per verification, so GOMEMLIMIT must stay above
# the ~40 MiB peak of a running login; below that the runtime collects in a loop
# while the buffer is live. The panel returns the buffer to the OS right after
# every hash (debug.FreeOSMemory in internal/panel/auth.go), which keeps the idle
# footprint at ~5 MiB instead of ~37 MiB and fits the service back into 64M.
Environment=GOMEMLIMIT=48MiB
MemoryHigh=48M
MemoryMax=64M
OOMScoreAdjust=500
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_SYS_RESOURCE
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# One mount is required for the deploy transactions: `ops` runs in this unit's
# namespace and renames `.staging/mods-*` into `mods/`, `players/` and `world/`.
# Separate ReadWritePaths bind mounts make rename(2) fail with EXDEV.
ReadWritePaths=/tes3mp-easy

[Install]
WantedBy=multi-user.target
