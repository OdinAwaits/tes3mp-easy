[Unit]
Description=TES3MP Easy panel
Documentation=https://github.com/Saagilat/tes3mp-easy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=2

[Service]
Type=simple
User=tes3mp-panel
Group=tes3mp-panel
SupplementaryGroups=tes3mp
EnvironmentFile=-/etc/tes3mp-easy/panel.env
WorkingDirectory=/opt/tes3mp-easy
ExecStart=/opt/tes3mp-easy/bin/tes3mp-easy-panel
Restart=on-failure
RestartSec=60s
TimeoutStartSec=5min
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=64MiB
MemoryHigh=48M
MemoryMax=64M
OOMScoreAdjust=500
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_SYS_RESOURCE
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/tes3mp-easy/panel-data
ReadWritePaths=/tes3mp-easy/players /tes3mp-easy/world /tes3mp-easy/mods
ReadWritePaths=/tes3mp-easy/backups /tes3mp-easy/configs /tes3mp-easy/.locks /tes3mp-easy/.staging

[Install]
WantedBy=multi-user.target
