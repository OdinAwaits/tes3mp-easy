[Unit]
Description=TES3MP Easy state backup
Documentation=https://github.com/Saagilat/tes3mp-easy

[Service]
Type=oneshot
User=tes3mp
Group=tes3mp
WorkingDirectory=/tes3mp-easy
ExecStart=/opt/tes3mp-easy/bin/tes3mp-easy-ops --root /tes3mp-easy --json backups create --type state --if-running
TimeoutStartSec=9min
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=64MiB
MemoryHigh=48M
MemoryMax=64M
OOMScoreAdjust=500
Nice=19
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/tes3mp-easy/backups /tes3mp-easy/.locks /tes3mp-easy/.staging
