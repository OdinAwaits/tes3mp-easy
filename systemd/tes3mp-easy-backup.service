[Unit]
Description=TES3MP Easy world checkpoint
Documentation=https://github.com/Saagilat/tes3mp-easy
# Before M2 the timer is already active while the ops binary does not exist.
# A condition (rather than a failing ExecStart) keeps the timer healthy and
# lets the first trigger after the ops install create a backup automatically.
ConditionPathExists=/opt/tes3mp-easy/bin/tes3mp-easy-ops

[Service]
Type=oneshot
User=tes3mp
Group=tes3mp
WorkingDirectory=/tes3mp-easy
ExecStart=/opt/tes3mp-easy/bin/tes3mp-easy-ops --root /tes3mp-easy --json checkpoint create --if-running
TimeoutStartSec=9min
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=64MiB
MemoryHigh=48M
MemoryMax=64M
OOMScoreAdjust=500
Nice=19
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/tes3mp-easy/backups /tes3mp-easy/.locks /tes3mp-easy/.staging
